# FlipScout Des Moines - backend environment
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is git-ignored. NEVER commit real credentials to this repository.
# Placeholders only in this file.

# ---------------------------------------------------------------------------
# eBay application credentials (required for /api/ebay/search)
# ---------------------------------------------------------------------------
# Create a free developer account at https://developer.ebay.com/, then:
#   Developer Portal -> Application Keys -> create a keyset.
# Use the PRODUCTION keyset with the default EBAY_API_BASE below, or the
# SANDBOX keyset with the sandbox base URL. They are not interchangeable.
#
# EBAY_CLIENT_ID is the "App ID (Client ID)".
EBAY_CLIENT_ID=your-ebay-app-id-here
# EBAY_CLIENT_SECRET is the "Cert ID (Client Secret)". Treat it like a password.
EBAY_CLIENT_SECRET=your-ebay-cert-id-here

# ---------------------------------------------------------------------------
# Optional settings (defaults shown)
# ---------------------------------------------------------------------------
# API host. Set to https://api.sandbox.ebay.com to use the eBay sandbox.
EBAY_API_BASE=https://api.ebay.com

# Marketplace sent as the X-EBAY-C-MARKETPLACE-ID header.
EBAY_MARKETPLACE_ID=EBAY_US

# Per-request HTTP timeout, in seconds.
REQUEST_TIMEOUT_SECONDS=20
